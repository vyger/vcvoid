# The M4 is the ONLY controller with R (colour) registers -- the Forge's
# numControllerRegisters declares REGISTER_RGB_LED: 4 for m4 and for no other
# model. A P2B8 has L1.1 ... L1.8 but no R at all (manual/hardware.md §6.4).
expect_load_error "no register R1.1 on the p2b8"
patch <<<
[p2b8]

[copy]
    input = 0.5
    output = R1.1
>>>

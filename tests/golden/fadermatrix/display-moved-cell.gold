# fadermatrix: the DB8E shows the cell you just moved (issue #22, Group B).
#
# fadermatrix.md "Display" is the manual page that states the rule for the
# whole bank family: the circuit "automatically updates the display whenever
# you move one of the faders. The title in the display is derived from the
# target of the `outputN` parameter. If that goes into a cable, the name of
# that cable is used as the title."
#
# 2x2 matrix, rowcolumn = I1 (0,1 select a row; 2,3 select a column):
#   cell (0,0) -> _TUNE  -> header "TUNE"
#   cell (0,1) -> O2     -> header "Output O2"
#   cell (1,0) -> O3     -> header "Output O3"
#   cell (1,1) -> O4     -> header "Output O4"
tickrate 100
patch <<<
[m4]
[db8e]

[fadermatrix]
    firstfader = 1
    rowcolumn  = I1
    output11   = _TUNE
    output12   = O2
    output21   = O3
    output22   = O4

[mixer]
    input1 = _TUNE
    output = O1
>>>
@0 set I1 0
@0 expectdisplay D1 off
# Row 0 is on the faders: F1 is cell (0,0), F2 is cell (0,1).
@1 move F1 0.3
@1 expectdisplay D1 value 0.3 tol 1e-5
@1 expectdisplay D1 header "TUNE"
@2 move F2 0.7
@2 expectdisplay D1 value 0.7 tol 1e-5
@2 expectdisplay D1 header "Output O2"
# Switching to row 1 moves the motors but changes no cell value, so the screen
# keeps the last reading.
@3 set I1 1
@3 expectdisplay D1 value 0.7 tol 1e-5
@3 expectdisplay D1 header "Output O2"
# Now F1 is cell (1,0) and F2 is cell (1,1): the titles follow the cells, not
# the physical faders.
@4 move F1 0.5
@4 expectdisplay D1 value 0.5 tol 1e-5
@4 expectdisplay D1 header "Output O3"
@5 move F2 0.9
@5 expectdisplay D1 value 0.9 tol 1e-5
@5 expectdisplay D1 header "Output O4"
# Back to column 0 (F1 = cell (0,0), F2 = cell (1,0)): moving F1 shows the
# matrix's first cell again, under its own cable name.
@6 set I1 2
@7 move F1 0.1
@7 expectdisplay D1 value 0.1 tol 1e-5
@7 expectdisplay D1 header "TUNE"

# encoder: the automatic DB8E header, derived from the `output` target.
# Spec: encoder.md `header` — "If you omit this, an automatic title is used. For
# example if the output of this circuit is fed into an internal patch cable, the
# name of this cable is displayed." hardware.md §6.12 shows the register form in
# its pot example: a value "for Output O1".
#
# Three targets, three encoders on one E4:
#   A -> _CUTOFF   (cable)    -> header "CUTOFF"   (leading _ dropped, as in the
#                                library-mode listing's VOICE_1_PITCH)
#   B -> O2        (register) -> header "Output O2"
#   C -> _DECAY but with an explicit header -> the explicit text wins
#
# The circuits are select-gated so exactly one owns the screen per tick and the
# assertions cannot race: I2 picks which one is live.
#
# SPEC-GAP: derived from the manual's wording plus the library-mode example, not
# from hardware. patches/tmp-autoheader-probe.ini captures the real strings; a
# target that is neither a cable nor an O register gets no header rather than a
# guessed wording (see deriveAutoHeader in engine/src/engine.cpp).
tickrate 100
patch <<<
[e4]
[db8e]

[encoder]
    encoder  = E1.1
    smooth   = 0
    select   = I2
    selectat = 0
    output   = _CUTOFF

[encoder]
    encoder  = E1.2
    smooth   = 0
    select   = I2
    selectat = 1
    output   = O2

[encoder]
    encoder  = E1.3
    smooth   = 0
    select   = I2
    selectat = 2
    header   = "MY OWN TITLE"
    output   = _DECAY

# Cables need a reader or the patch will not load.
[mixer]
    input1 = _CUTOFF
    input2 = _DECAY
    output = O1
>>>
@0 expectdisplay D1 off
@1 turn E1.1 48
@1 expectdisplay D1 value 0.5 tol 1e-6
@1 expectdisplay D1 header "CUTOFF"
@2 set I2 1
@2 turn E1.2 24
@2 expectdisplay D1 value 0.25 tol 1e-6
@2 expectdisplay D1 header "Output O2"
@3 set I2 2
@3 turn E1.3 96
@3 expectdisplay D1 value 1.0 tol 1e-6
@3 expectdisplay D1 header "MY OWN TITLE"

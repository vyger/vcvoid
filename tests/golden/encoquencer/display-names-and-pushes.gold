# encoquencer: `cvname` / `gatename`, the encoder PUSHES and `display = 0`
# (issue #22, Group C).
#
# Measured on a DB8E (blue-7):
#   * `cvname` replaces the pitch title, quantized or not;
#   * `gatename` replaces "Gate" and the words become "on" / "off" (also the
#     manual's wording);
#   * pushes show the same screens as turns; start/end shows "Playing range"
#     over first-last ("1-2").
# The second circuit is identical but `display = 0`: if it leaked onto D2
# (its only other choice) the `off` checks there would fail.
tickrate 100
patch <<<
[db8e]
[db8e]
[e4]

[encoquencer]
    fadermode  = I2 * 10
    quantize   = I3 * 10
    buttonmode = I4 * 10
    cvname     = "Melody"
    gatename   = "Accent"
    cv         = O1
    gate       = O2

[encoquencer]
    fadermode  = I2 * 10
    buttonmode = I4 * 10
    display    = 0
    cv         = O3
    gate       = O4
>>>
@0 set I3 0.2
@0 expectdisplay D1 off
@0 expectdisplay D2 off
# Pitch: two scale notes up from C0 is E0, under the patch's own name.
@1 turn E3.1 2
@1 expectdisplay D1 note 4 octave
@1 expectdisplay D1 header "Melody"
# Unquantized, still "Melody" rather than the `cv` target.
@2 set I3 0
@3 turn E3.1 1
@3 expectdisplay D1 header "Melody"
@3 expectdisplay D1 mode 3
# Push, gates: step 2 starts on, the push turns it off -> "off" under "Accent".
@4 push E3.2 1
@4 expectdisplay D1 text "off"
@4 expectdisplay D1 header "Accent"
@5 push E3.2 0
# Turn, gate mode: back on -> "on".
@6 set I2 0.6
@7 turn E3.2 1
@7 expectdisplay D1 text "on"
@7 expectdisplay D1 header "Accent"
# Push, start/end: a single push sets the end -> steps 1 to 2.
@8 set I4 0.1
@9 push E3.2 1
@9 expectdisplay D1 range 1 2
@9 expectdisplay D1 header "Playing range"
@10 push E3.2 0
# Push, gate pattern: 0 -> 1.
@11 set I4 0.2
@12 push E3.1 1
@12 expectdisplay D1 gatepattern 1
@12 expectdisplay D1 header "Gate pattern"
@13 push E3.1 0
# Push, skip: on -> "skip"; again -> "play".
@14 set I4 0.3
@15 push E3.1 1
@15 expectdisplay D1 text "skip"
@15 expectdisplay D1 header "Skip"
@16 push E3.1 0
@17 push E3.1 1
@17 expectdisplay D1 text "play"
@18 push E3.1 0
@18 expectdisplay D2 off

# encoquencer: what the DB8E shows when you TURN an encoder (issue #22, Group C).
#
# encoquencer.md: the circuit "automatically uses the display whenever you edit
# something in the sequencer". Measured on a DB8E (blue-7), default titles:
#
#   pitch, quantize 2/1   "Pitch" / the dialed note WITH octave (NoteName)
#   pitch, quantize 0     "Output O1" (the `cv` target) / 0..1 position, 2 dp
#   randomize             "Randomize" / 0..7
#   gate probability      "Probability" / "50%"
#   repeats, ratchets     "Repeats", "Ratchets" / the count
#   gate pattern          "Gate pattern" / a picture: the pattern index
#   gate                  "Gate" / "play" | "silent"
#   skip                  "Skip" / "skip" | "play"
#
# The DB8E is controller 1, so the E4 encoders are E2.n. fadermode and
# quantize come in on I2 / I3 (x10), so 0.3 on I2 is fader mode 3.
tickrate 100
patch <<<
[db8e]
[e4]

[encoquencer]
    fadermode = I2 * 10
    quantize  = I3 * 10
    cv        = O1
    gate      = O2
>>>
@0 set I3 0.2
# Loading the patch shows nothing: only an edit wakes the screen.
@0 expectdisplay D1 off
# Pitch, quantize 2 (C lydian): seven notches up is C one octave up.
@1 turn E2.1 7
@1 expectdisplay D1 note 12 octave
@1 expectdisplay D1 header "Pitch"
# Quantize 1: every semitone. The step sits at the middle notch (C1 = 12 of
# 0..24); one more is C#1.
@2 set I3 0.1
@3 turn E2.1 1
@3 expectdisplay D1 note 13 octave
# Quantize 0: the position itself (13/24 + 1/96), two decimals, titled from
# where `cv` goes.
@4 set I3 0
@5 turn E2.1 1
@5 expectdisplay D1 value 0.552083 tol 1e-4
@5 expectdisplay D1 mode 3
@5 expectdisplay D1 header "Output O1"
# Randomize: 0 -> 1, an integer.
@6 set I2 0.1
@7 turn E2.1 1
@7 expectdisplay D1 value 1
@7 expectdisplay D1 mode 1
@7 expectdisplay D1 header "Randomize"
# Gate probability: down one from "always" is 50%.
@8 set I2 0.2
@9 turn E2.1 -1
@9 expectdisplay D1 text "50%"
@9 expectdisplay D1 header "Probability"
# ... and on down through all eight words, as measured.
@10 turn E2.1 -1
@10 expectdisplay D1 text "even turns"
@11 turn E2.1 -1
@11 expectdisplay D1 text "odd turns"
@12 turn E2.1 -1
@12 expectdisplay D1 text "25%"
@13 turn E2.1 -1
@13 expectdisplay D1 text "every 4th"
@14 turn E2.1 -1
@14 expectdisplay D1 text "12%"
@15 turn E2.1 -1
@15 expectdisplay D1 text "if last"
@16 turn E2.1 7
@16 expectdisplay D1 text "always"
# Repeats: 1 -> 2.
@17 set I2 0.3
@18 turn E2.1 1
@18 expectdisplay D1 value 2
@18 expectdisplay D1 header "Repeats"
# Gate pattern: 0 -> 1 (every repetition), sent as the index.
@19 set I2 0.4
@20 turn E2.1 1
@20 expectdisplay D1 gatepattern 1
@20 expectdisplay D1 header "Gate pattern"
# Ratchets: 1 -> 2.
@21 set I2 0.5
@22 turn E2.1 1
@22 expectdisplay D1 value 2
@22 expectdisplay D1 header "Ratchets"
# Gate: on (switched on by the pitch edit) -> off.
@23 set I2 0.6
@24 turn E2.1 -1
@24 expectdisplay D1 text "silent"
@24 expectdisplay D1 header "Gate"
# Skip: off -> on.
@25 set I2 0.7
@26 turn E2.1 1
@26 expectdisplay D1 text "skip"
@26 expectdisplay D1 header "Skip"
# A turn past the end changes nothing but still answers on the screen: back to
# gate, already off, turned down again.
@27 set I2 0.6
@28 turn E2.1 -1
@28 expectdisplay D1 text "silent"
@28 expectdisplay D1 header "Gate"

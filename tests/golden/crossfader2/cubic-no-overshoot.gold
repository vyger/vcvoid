# Alternating inputs 0.05/0.9/0.1/0.85, loop=1 (S=4, p=fade*4), curve=1: every
# knot is a local extremum on the ring, so its two secants have opposite signs
# and every tangent is zero. The curve then passes exactly through each knot
# (fade 0/.25/.5/.75) and, with both tangents zero, each segment is the raised
# cosine between its two knots: it stays within [min,max] of the pair (no
# overshoot) and the midpoint (f=0.5, h00=h01=0.5) is the plain average:
#   fade 0.125 -> p=0.5 -> (0.05+0.9)/2  = 0.475
#   fade 0.375 -> p=1.5 -> (0.9+0.1)/2   = 0.5
#   fade 0.625 -> p=2.5 -> (0.1+0.85)/2  = 0.475
#   fade 0.875 -> p=3.5 -> (0.85+0.05)/2 = 0.45
experimental
patch <<<
[crossfader2]
    input1 = I1
    input2 = I2
    input3 = I3
    input4 = I4
    fade   = I5
    curve  = 1
    loop   = 1
    output = O1
>>>
@0 set I1 0.05
@0 set I2 0.9
@0 set I3 0.1
@0 set I4 0.85
@0 set I5 0
@0 expect O1 0.05
@1 set I5 0.125
@1 expect O1 0.475
@2 set I5 0.25
@2 expect O1 0.9
@3 set I5 0.375
@3 expect O1 0.5
@4 set I5 0.5
@4 expect O1 0.1
@5 set I5 0.625
@5 expect O1 0.475
@6 set I5 0.75
@6 expect O1 0.85
@7 set I5 0.875
@7 expect O1 0.45

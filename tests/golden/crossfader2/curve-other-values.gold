# `curve` is clamped to 0..2 after rounding. N=4 spike 1/0/0/0, loop=1 (S=4,
# p = fade*4), one circuit per value:
#   curve = -1  -> 0 (linear):   fade 0.375 -> p=1.5 -> 0.5*i2 + 0.5*i3 = 0
#   curve = 1.4 -> 1 (cubic):    fade 0.375 -> seg 1 (0 -> 0), both tangents 0
#                                (i2 and i3 are extrema/flat)              = 0
#   curve = 7   -> 2 (Fourier):  fade 0.375 -> t=1.5 -> D(1.5) with N=4:
#                                sin(1.5pi) cos(1.5pi/4) / (4 sin(1.5pi/4))
#                                = -1 * cos(3pi/8) / (4 sin(3pi/8))
#                                = -1 / (4 tan(3pi/8)) = -1/(4*2.414214)  = -0.103553
# The Fourier line is the one that distinguishes a high clamp from 1:
# Fourier is the only mode that goes negative there.
experimental
patch <<<
[crossfader2]
    input1 = I1
    input2 = I2
    input3 = I3
    input4 = I4
    fade   = I5
    curve  = -1
    loop   = 1
    output = O1
>>>

patch <<<
[crossfader2]
    input1 = I1
    input2 = I2
    input3 = I3
    input4 = I4
    fade   = I5
    curve  = 1.4
    loop   = 1
    output = O2
>>>

patch <<<
[crossfader2]
    input1 = I1
    input2 = I2
    input3 = I3
    input4 = I4
    fade   = I5
    curve  = 7
    loop   = 1
    output = O3
>>>
@0 set I1 1
@0 set I2 0
@0 set I3 0
@0 set I4 0
@0 set I5 0.375
@0 expect O1 0
@0 expect O2 0
@0 expect O3 -0.103553 tol 1e-5
@1 set I5 0.125
@1 expect O1 0.5
@1 expect O2 0.5
@1 expect O3 0.603553 tol 1e-5

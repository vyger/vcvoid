# motoquencer `pattern` = 6 -- "go forward by a small random number of steps"
# -->x? (issue #54). This is the one pattern that has no arpeggio counterpart
# ("the available patterns are much the same as in the arpeggio circuit with the
# addition of pattern 6").
#
# SPEC-GAP: "a small random number" is all the manual offers. We draw uniformly
# from 1..3 steps, one draw per clock, off the engine's seeded xorshift. Values
# below are the exact seed-1 draws.
#
# Because the walk only ever moves forwards, the cycle rule is the ordinary one: a
# jump that would land past the last step restarts the sequence instead, so a turn
# is a short, ragged run up the steps -- 0,1,3,4,7 then 0,2,4,5 then 0,2,3,6.
# `startofsequence` marks each restart.
# Step numbers do not fit on an output jack (they clamp at +/-10 V), so
# `currentstep` rides an internal cable scaled by 1/10: step N reads N/10.
seed 1
tickrate 100
patch <<<
[m4]
[m4]
[motoquencer]
    clock           = I1
    numsteps        = 8
    numfaders       = 8
    pattern         = 6
    currentstep     = _CS
    startofsequence = O2
[copy]
    input  = _CS * 0.1
    output = O1
>>>
@2 set I1 1
@2 expect O1 0 tol 1e-4
@2 expect O2 1 tol 1e-4
@3 set I1 0
@4 set I1 1
@4 expect O1 0.1 tol 1e-4
@4 expect O2 0 tol 1e-4
@5 set I1 0
@6 set I1 1
@6 expect O1 0.3 tol 1e-4
@6 expect O2 0 tol 1e-4
@7 set I1 0
@8 set I1 1
@8 expect O1 0.4 tol 1e-4
@8 expect O2 0 tol 1e-4
@9 set I1 0
@10 set I1 1
@10 expect O1 0.7 tol 1e-4
@10 expect O2 0 tol 1e-4
@11 set I1 0
@12 set I1 1
@12 expect O1 0 tol 1e-4
@12 expect O2 1 tol 1e-4
@13 set I1 0
@14 set I1 1
@14 expect O1 0.2 tol 1e-4
@14 expect O2 0 tol 1e-4
@15 set I1 0
@16 set I1 1
@16 expect O1 0.4 tol 1e-4
@16 expect O2 0 tol 1e-4
@17 set I1 0
@18 set I1 1
@18 expect O1 0.5 tol 1e-4
@18 expect O2 0 tol 1e-4
@19 set I1 0
@20 set I1 1
@20 expect O1 0 tol 1e-4
@20 expect O2 1 tol 1e-4
@21 set I1 0
@22 set I1 1
@22 expect O1 0.2 tol 1e-4
@22 expect O2 0 tol 1e-4
@23 set I1 0
@24 set I1 1
@24 expect O1 0.3 tol 1e-4
@24 expect O2 0 tol 1e-4
@25 set I1 0
@26 set I1 1
@26 expect O1 0.6 tol 1e-4
@26 expect O2 0 tol 1e-4
@27 set I1 0
@28 set I1 1
@28 expect O1 0 tol 1e-4
@28 expect O2 1 tol 1e-4
@29 set I1 0

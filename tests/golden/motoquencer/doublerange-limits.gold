# motoquencer `doublerange`, the two boundary cases.
#
# 1. "This only works if the playing range (start/stop) is not at maximum" — a
#    trigger with the end already at numsteps does nothing at all.
# 2. SPEC-GAP: a range that has no room for a FULL second copy (5 steps of 8).
#    The manual only rules out the at-maximum case. Literal reading: copy as many
#    steps as fit and clamp the end to numsteps, so 1..5 becomes 1..8 with steps
#    6, 7, 8 taking steps 1, 2, 3. The alternative — no-op unless 2L fits — would
#    make doublerange silently dead on most odd ranges.
#
# All eight steps are dialled to distinct CVs (0.1 .. 0.8) so every copy is
# visible on the recalled motor faders.
tickrate 100
patch <<<
[m4]
[motoquencer]
    clock       = I1
    numsteps    = 8
    numfaders   = 4
    page        = I5
    quantize    = 0
    cvbase      = 0
    cvrange     = 1
    defaultgate = 1
    setendstep  = I3
    doublerange = I4
    cv          = O1
    endstepout  = _ES
[copy]
    input  = _ES * 0.1
    output = O4
>>>
@1 move F1 0.1
@2 move F2 0.2
@3 move F3 0.3
@4 move F4 0.4
@5 set I5 1
@6 move F1 0.5
@7 move F2 0.6
@8 move F3 0.7
@9 move F4 0.8
@10 set I5 0
# at maximum (end = numsteps = 8): the trigger does nothing
@11 expect O4 0.8 tol 1e-4
@12 set I4 1
@12 expect O4 0.8 tol 1e-4
@13 set I4 0
@14 set I5 1
@15 expect F1 0.5 tol 1e-4
@15 expect F2 0.6 tol 1e-4
@15 expect F3 0.7 tol 1e-4
@15 expect F4 0.8 tol 1e-4
@16 set I5 0
# a 5-step range: only three steps fit past the end, so the copy is partial and
# the end clamps to numsteps
@17 set I3 5
@17 expect O4 0.5 tol 1e-4
@18 set I4 1
@18 expect O4 0.8 tol 1e-4
@19 set I4 0
@20 set I5 1
# step 5 untouched; steps 6, 7, 8 <- steps 1, 2, 3
@21 expect F1 0.5 tol 1e-4
@21 expect F2 0.1 tol 1e-4
@21 expect F3 0.2 tol 1e-4
@21 expect F4 0.3 tol 1e-4
@22 set I5 0
# ...and the first half is untouched
@23 expect F1 0.1 tol 1e-4
@23 expect F2 0.2 tol 1e-4
@23 expect F3 0.3 tol 1e-4
@23 expect F4 0.4 tol 1e-4
# now back at maximum again: another trigger is a no-op
@24 set I4 1
@24 expect O4 0.8 tol 1e-4
@25 set I4 0
@26 expect F1 0.1 tol 1e-4

# motoquencer `pattern` = 3 -- "double step forward, double step backward,
# single step forward" =>|<=|> (issue #54): the delta cycle +2, -2, +1, which from
# step 0 of eight reads 0, 2, 0, 1, 3, 1, 2, 4, 2, 3, 5, ... -- net one step
# forward per three clocks. Same figure as arpeggio's pattern 3.
#
# Note the second move: -2 out of step 2 lands back on step 0, the step the walk
# started from. Nothing forbids revisiting a step; the figure is what the manual
# names, not a permutation.
# Step numbers do not fit on an output jack (they clamp at +/-10 V), so
# `currentstep` rides an internal cable scaled by 1/10: step N reads N/10.
tickrate 100
patch <<<
[m4]
[m4]
[motoquencer]
    clock           = I1
    numsteps        = 8
    numfaders       = 8
    pattern         = 3
    currentstep     = _CS
    startofsequence = O2
[copy]
    input  = _CS * 0.1
    output = O1
>>>
@2 set I1 1
@2 expect O1 0 tol 1e-4
@2 expect O2 1 tol 1e-4
@3 set I1 0
@4 set I1 1
@4 expect O1 0.2 tol 1e-4
@4 expect O2 0 tol 1e-4

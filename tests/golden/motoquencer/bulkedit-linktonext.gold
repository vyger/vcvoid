# motoquencer `bulkedit` on a linked chain. The chain shares ONE fader bank and
# `fadermode / 10` says which member owns it (motoquencer.md `linktonext`), so a
# bulk edit belongs to whichever instance is being edited: it stamps the steps of
# THAT lane and nothing else. The other lanes of the same track keep their values,
# exactly as a single-fader edit does.
#
# fadermode 10 hands the faders to the linked member; with CTRL held, moving lane
# 2 stamps the member's steps 1..3. Switching back to fadermode 0 shows the main's
# four steps untouched, and playing the track confirms it per step: the main plays
# 0.25 / 0 / 0 / 0 while the member plays 0 / 0.75 / 0.75 / 0.75.
tickrate 100
patch <<<
[m4]
[motoquencer]
    clock       = I1
    bulkedit    = I2
    fadermode   = I3
    linktonext  = 1
    numfaders   = 4
    numsteps    = 4
    quantize    = 0
    cvbase      = 0
    cvrange     = 1
    holdcv      = 0
    defaultgate = 1
    cv          = O1

[motoquencer]
    bulkedit    = I2
    quantize    = 0
    cvbase      = 0
    cvrange     = 1
    holdcv      = 0
    cv          = O2
>>>
# the main owns the faders: dial step 0 to 0.25 with bulkedit low.
@0 set I2 0
@0 set I3 0
@1 move F1 0.25
@1 expect F1 0.25 tol 1e-4
@1 expect F2 0 tol 1e-4
# hand the faders to the linked member and hold CTRL.
@2 set I3 10
@2 expect F1 0 tol 1e-4
@3 set I2 1
# lane 2 = the member's step 1 -> the member's steps 2 and 3 follow.
@4 move F2 0.75
@4 expect F1 0 tol 1e-4
@4 expect F2 0.75 tol 1e-4
@4 expect F3 0.75 tol 1e-4
@4 expect F4 0.75 tol 1e-4
# back to the main's lane: its own steps were never stamped.
@5 set I3 0
@5 expect F1 0.25 tol 1e-4
@5 expect F2 0 tol 1e-4
@5 expect F3 0 tol 1e-4
@5 expect F4 0 tol 1e-4
# play the four steps: main 0.25/0/0/0, member 0/0.75/0.75/0.75.
@6 set I1 1
@6 expect O1 0.25 tol 1e-4
@6 expect O2 0 tol 1e-4
@7 set I1 0
@8 set I1 1
@8 expect O1 0 tol 1e-4
@8 expect O2 0.75 tol 1e-4
@9 set I1 0
@10 set I1 1
@10 expect O1 0 tol 1e-4
@10 expect O2 0.75 tol 1e-4
@11 set I1 0
@12 set I1 1
@12 expect O1 0 tol 1e-4
@12 expect O2 0.75 tol 1e-4
@13 set I1 0

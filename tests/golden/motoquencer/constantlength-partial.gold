# motoquencer `constantlength`: an edit the range cannot pay for.
#
# SPEC-GAP (documented in seqcore.hpp). motoquencer.md:922 only promises that the
# feature "*tries* to keep the actual length of the sequence constant" and never
# says what happens when the other steps have no slack left. Literal reading: the
# user's edit always stands — compensate as far as the slack goes and drop the
# remainder. The alternative (refusing the edit, or snapping the fader back) would
# make a motor fader fight the hand that is holding it.
#
# `endstep = 2` narrows the range to steps 1 and 2, and step 2 has 2 repeats — one
# spare clock, since 1 is the floor. Step 1 is dialled from 1 to 5 repeats: step 2
# gives its single spare clock (2 -> 1), the other 3 are simply dropped, and the
# fader stays where the hand put it. The cycle grows from 3 clocks to 6.
tickrate 100
patch <<<
[m4]
[motoquencer]
    clock          = I1
    fadermode      = I2
    constantlength = I3
    endstep        = 2
    numsteps       = 4
    numfaders      = 4
    quantize       = 0
    cvbase         = 0
    cvrange        = 1
    defaultgate    = 1
    cv             = O1
>>>
@2 move F1 0.0
@3 move F2 0.25
@4 move F3 0.5
@5 move F4 0.75
@6 set I2 3
# with the feature off: step 2 -> 2 repeats (notch 1)
@7 move F2 0.0666667
@7 expect F2 0.0666667 tol 1e-4
@8 set I3 1
# step 1: 1 -> 5 repeats (notch 4). Step 2 can only give 1 of the 4 clocks.
@9 move F1 0.2666667
@9 expect F1 0.2666667 tol 1e-4
@9 expect F2 0 tol 1e-4
@10 set I2 0
# 6 clocks per cycle: step 1 five times, step 2 once.
@12 set I1 1
@12 expect O1 0 tol 1e-4
@13 set I1 0
@14 set I1 1
@14 expect O1 0 tol 1e-4
@15 set I1 0
@16 set I1 1
@16 expect O1 0 tol 1e-4
@17 set I1 0
@18 set I1 1
@18 expect O1 0 tol 1e-4
@19 set I1 0
@20 set I1 1
@20 expect O1 0 tol 1e-4
@21 set I1 0
@22 set I1 1
@22 expect O1 0.25 tol 1e-4
@23 set I1 0
@24 set I1 1
@24 expect O1 0 tol 1e-4
@25 set I1 0

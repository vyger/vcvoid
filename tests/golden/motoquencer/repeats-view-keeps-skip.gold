# motoquencer: the automatic skip clear is tied to an actual repeats CHANGE, not
# to fadermode 3 being on screen. motoquencer.md:183-184 — "When you *change* the
# number of repeats of a step, the skip setting of that step is automatically
# cleared" — so merely looking at the repeats lane (or resting a finger on a
# fader that is already at its dent) must leave the skips alone.
#
# Step 2 is skipped, fadermode 3 is selected and held there for several ticks
# with nothing moved, and the sequence still plays the 3-step skipped cycle.
tickrate 100
patch <<<
[m4]
[motoquencer]
    clock       = I1
    fadermode   = I2
    buttonmode  = 3
    numsteps    = 4
    numfaders   = 4
    quantize    = 0
    cvbase      = 0
    cvrange     = 1
    defaultgate = 1
    cv          = O1
>>>
@2 move F1 0.0
@3 move F2 0.25
@4 move F3 0.5
@5 move F4 0.75
# plate 2 skips step 2
@6 touch F2 1
@7 touch F2 0
# look at the repeats lane for a while, touching nothing
@8 set I2 3
@8 expect F2 0 tol 1e-4
@9 expect F2 0 tol 1e-4
@10 expect F2 0 tol 1e-4
@11 set I2 0
# the skip survived: 3 clocks per cycle, steps 1, 3, 4
@13 set I1 1
@13 expect O1 0 tol 1e-4
@14 set I1 0
@15 set I1 1
@15 expect O1 0.5 tol 1e-4
@16 set I1 0
@17 set I1 1
@17 expect O1 0.75 tol 1e-4
@18 set I1 0
@19 set I1 1
@19 expect O1 0 tol 1e-4
@20 set I1 0

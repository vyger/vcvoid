# motoquencer `bulkedit`, fader lane. motoquencer.md: "If you set this to 1, then
# if you move one fader (or encoder) [...] all other faders (or encoders) *at the
# right of the modified step* will move along to the same value". "At the right"
# is read as every HIGHER step number up to `numsteps` — the whole track, not
# just the played range — and the steps to the LEFT are never touched.
#
# Step 0 is dialed to 0.1 with bulkedit low. Then CTRL (bulkedit) is held and step
# 1's fader is moved to 0.75: steps 2 and 3 move along (their motors are
# re-commanded in the same tick, so `expect F` sees it) while step 0 keeps 0.1.
# Dropping bulkedit restores plain per-step editing.
#
# SPEC-GAP: the pitch edit's gate auto-on ("The gate is automatically switched on
# when you change the note value of a step") applies to the step whose fader was
# really MOVED. bulkedit copies the addressed lane's value and nothing else — a
# single CTRL move must not silently switch on the gates of the rest of the
# track. So steps 0, 1 and 3 gate (they were each moved) and step 2 does not,
# even though it took step 1's pitch.
tickrate 100
patch <<<
[m4]
[motoquencer]
    clock       = I1
    bulkedit    = I2
    numsteps    = 4
    numfaders   = 4
    quantize    = 0
    cvbase      = 0
    cvrange     = 1
    holdcv      = 0
    defaultgate = 0
    cv          = O1
    gate        = O2
>>>
# step 0 on its own, bulkedit low.
@0 set I2 0
@1 move F1 0.1
@1 expect F1 0.1 tol 1e-4
@1 expect F2 0 tol 1e-4
# hold bulkedit, move step 1's fader: steps 2 and 3 follow, step 0 does not.
@2 set I2 1
@3 move F2 0.75
@3 expect F1 0.1 tol 1e-4
@3 expect F2 0.75 tol 1e-4
@3 expect F3 0.75 tol 1e-4
@3 expect F4 0.75 tol 1e-4
# the stamped lanes stay put on the following ticks (they are not read back).
@4 expect F3 0.75 tol 1e-4
@4 expect F4 0.75 tol 1e-4
# drop bulkedit: editing is per-step again.
@5 set I2 0
@6 move F4 0.2
@6 expect F3 0.75 tol 1e-4
@6 expect F4 0.2 tol 1e-4
# play the track: 0.1 / 0.75 / 0.75 / 0.2, with the gate off on the step that was
# only stamped (step 2).
@7 set I1 1
@7 expect O1 0.1 tol 1e-4
@7 expect O2 1 tol 1e-4
@8 set I1 0
@9 set I1 1
@9 expect O1 0.75 tol 1e-4
@9 expect O2 1 tol 1e-4
@10 set I1 0
@11 set I1 1
@11 expect O1 0.75 tol 1e-4
@11 expect O2 0 tol 1e-4
@12 set I1 0
@13 set I1 1
@13 expect O1 0.2 tol 1e-4
@13 expect O2 1 tol 1e-4
@14 set I1 0

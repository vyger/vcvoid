@10 set I1 1
@10 expect O1 0.6 tol 1e-4
@10 expect O2 0 tol 1e-4
@11 set I1 0
@12 set I1 1
@12 expect O1 0.7 tol 1e-4
@12 expect O2 0 tol 1e-4

@14 set I1 1
@14 expect O1 0.6 tol 1e-4
@14 expect O2 0 tol 1e-4
@15 set I1 0
@16 set I1 1
@16 expect O1 0.5 tol 1e-4
@16 expect O2 0 tol 1e-4
@17 set I1 0
@18 set I1 1
@18 expect O1 0 tol 1e-4
@18 expect O2 1 tol 1e-4

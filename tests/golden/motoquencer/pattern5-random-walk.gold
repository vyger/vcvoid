# motoquencer `pattern` = 5 -- "random single step forward or backward" <-> (issue
# #54). A drunk walk: one coin flip per clock off the engine's seeded xorshift
# (the same stream `lucky` and gate probability draw from), u < 0.5 -> back,
# else forward. Values below are the exact seed-1 draws; regenerate by capturing
# the "got" values if the draw order ever changes.
#
# Two SPEC-GAPs the manual leaves open, both pinned here:
#   * a backward move off the START of the sequence wraps round to the end rather
#     than clamping or bouncing -- the very first move, 0 -> 7.
#   * a drunk walk never "crosses the end", so there is no natural cycle. We count
#     one every N moves, N = the number of steps in the play order (8 here): as
#     many notes per turn as a linear pass would have played. That Nth move is the
#     restart itself -- back to step 0, with `startofsequence`.
# Step numbers do not fit on an output jack (they clamp at +/-10 V), so
# `currentstep` rides an internal cable scaled by 1/10: step N reads N/10.
seed 1
tickrate 100
patch <<<
[m4]
[m4]
[motoquencer]
    clock           = I1
    numsteps        = 8
    numfaders       = 8
    pattern         = 5
    currentstep     = _CS
    startofsequence = O2
[copy]
    input  = _CS * 0.1
    output = O1
>>>
@2 set I1 1
@2 expect O1 0 tol 1e-4
@2 expect O2 1 tol 1e-4
@3 set I1 0
@4 set I1 1
@4 expect O1 0.7 tol 1e-4
@4 expect O2 0 tol 1e-4
@5 set I1 0
@6 set I1 1
@6 expect O1 0.6 tol 1e-4
@6 expect O2 0 tol 1e-4
@7 set I1 0
@8 set I1 1
@8 expect O1 0.7 tol 1e-4
@8 expect O2 0 tol 1e-4

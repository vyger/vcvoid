# motoquencer: `luckyscope` 0 (the default) restricts a lucky op to the steps
# between the current start and end step (the `luckyscope` Inputs row: "0 = all
# steps between the current start and end step"). Characterisation of the range
# as read by luckyTargets().
#
# 4 steps, every gate on (defaultgate = 1). With the range narrowed to steps
# 2..3, `luckygates` at luckyamount = 0 clears the gates of steps 2 and 3 only.
# The range is then widened back to 1..4 before the transport starts, so all
# four steps can be heard: the played gates must be on, off, off, on.
tickrate 100
patch <<<
[m4]
[motoquencer]
    numfaders   = 4
    numsteps    = 4
    quantize    = 0
    defaultgate = 1
    clock       = I1
    startstep   = I4
    endstep     = I5
    gate        = O2
    luckygates  = I2
    luckyamount = I3
>>>
# narrow the range to steps 2..3, then clear those gates (luckyamount = 0)
@0 set I4 2
@0 set I5 3
@1 set I3 0
@2 set I2 1
@3 set I2 0
# widen the range back to the full four steps before the first clock edge
@4 set I4 1
@4 set I5 4
# step 1: outside the lucky range, still gating (period unknown -> clock level)
@5 set I1 1
@5 expect O2 1 tol 1e-4
@6 set I1 0
# steps 2 and 3: cleared by luckygates
@7 set I1 1
@7 expect O2 0 tol 1e-4
@8 set I1 0
@9 set I1 1
@9 expect O2 0 tol 1e-4
@10 set I1 0
# step 4: outside the range again, still gating
@11 set I1 1
@11 expect O2 1 tol 1e-4
@12 set I1 0

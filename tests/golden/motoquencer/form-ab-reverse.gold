# motoquencer `form` = 5 (AB) combined with `direction` = 1 -- the case the manual
# calls out explicitly (issue #53):
#
#   "The pattern AB is really not the same as A, e.g when `direction` is set 1
#    (reverse). In that case each of the parts is played backwards, but the parts
#    themselves move forwards on your steps."
#
# So over four steps the order is 1,0 then 3,2 -- NOT the plain reverse 3,2,1,0
# that form 0 would give (see playorder-char-reverse-pingpong.gold). Stepping
# modifications are "always applied within each individual part"; the parts
# themselves always run forward.
# Step numbers do not fit on an output jack (they clamp at +/-10 V), so
# `currentstep` rides an internal cable scaled by 1/10: step N reads N/10.
tickrate 100
patch <<<
[m4]
[motoquencer]
    clock           = I1
    numsteps        = 4
    numfaders       = 4
    form            = 5
    direction       = 1
    currentstep     = _CS
    startofpart     = O3
    startofsequence = O2
[copy]
    input  = _CS * 0.1
    output = O1
>>>
@2 set I1 1
@2 expect O1 0.1 tol 1e-4
@2 expect O3 1 tol 1e-4
@2 expect O2 1 tol 1e-4
@3 set I1 0
@4 set I1 1
@4 expect O1 0 tol 1e-4
@4 expect O3 0 tol 1e-4
@4 expect O2 0 tol 1e-4
@5 set I1 0
@6 set I1 1
@6 expect O1 0.3 tol 1e-4
@6 expect O3 1 tol 1e-4
@6 expect O2 0 tol 1e-4
@7 set I1 0
@8 set I1 1
@8 expect O1 0.2 tol 1e-4
@8 expect O3 0 tol 1e-4
@8 expect O2 0 tol 1e-4
@9 set I1 0
@10 set I1 1
@10 expect O1 0.1 tol 1e-4
@10 expect O3 1 tol 1e-4
@10 expect O2 1 tol 1e-4
@11 set I1 0

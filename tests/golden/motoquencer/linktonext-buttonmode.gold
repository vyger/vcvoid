# motoquencer linktonext: buttonmode + 10 addresses the linked member's step
# buttons (#29). motoquencer.md: "for accessing the parameters of the steps of
# the linked sequencer, add 10 to fadermode or buttonmode". The chain reads ONE
# buttonmode off the main; `buttonmode / 10` picks which member owns the touch
# plates (editing with `buttonmode % 10`), independently of the fader owner.
#
# Both instances start with every gate on (defaultgate). With buttonmode 0 a
# touch on plate 1 silences the MAIN's step 1 only; with buttonmode 10 the same
# touch silences the MEMBER's step 1 only. The member's own `buttonmode` input
# is ignored (fed 10 here to prove it does nothing).
tickrate 100
patch <<<
[m4]
[motoquencer]
    clock      = I1
    buttonmode = I2
    numsteps   = 4
    numfaders  = 4
    linktonext = 1
    cv         = O1
    gate       = O2
[motoquencer]
    buttonmode = 10
    cv         = O3
    gate       = O4
>>>
# buttonmode 0: plate 1 toggles the main's gate[0] off, the member keeps its gate.
@1 set I2 0
@2 touch F1 1
@3 touch F1 0
@4 set I1 1
@4 expect O2 0 tol 1e-4
@4 expect O4 1 tol 1e-4
@5 set I1 0
# step 2: both still gate.
@6 set I1 1
@6 expect O2 1 tol 1e-4
@6 expect O4 1 tol 1e-4
@7 set I1 0
# buttonmode 10: plate 1 now toggles the MEMBER's gate[0] off (the main's
# gate[0] is untouched, i.e. still off from above).
@8 set I2 10
@9 touch F1 1
@10 touch F1 0
# steps 3, 4 pass...
@11 set I1 1
@12 set I1 0
@13 set I1 1
@14 set I1 0
# ...wrap to step 1: main silent (from tick 2), member silent (from tick 9).
@15 set I1 1
@15 expect O2 0 tol 1e-4
@15 expect O4 0 tol 1e-4
@16 set I1 0
# buttonmode 0 again: plate 1 re-arms the MAIN's gate[0]; the member stays off.
@17 set I2 0
@18 touch F1 1
@19 touch F1 0
@20 set I1 1
@21 set I1 0
@22 set I1 1
@23 set I1 0
@24 set I1 1
@25 set I1 0
@26 set I1 1
@26 expect O2 1 tol 1e-4
@26 expect O4 0 tol 1e-4

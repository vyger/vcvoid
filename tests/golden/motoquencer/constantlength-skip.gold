# motoquencer `constantlength = 2`: skip toggles are compensated too.
# motoquencer.md:922 — "The second level is `constantlength = 2`. Here also the
# *skip* setting of steps is honored and modified in order to keep the length
# constant. A skipped step essentially has the length 0 (or 0 repeats). The
# componsation is now done not only when the repeats are changed but also when
# skip is switched on or off on a step."
#
# Step 3 is dialled to 4 repeats with the feature off, so the cycle is
# 1 + 1 + 4 + 1 = 7 clocks. At level 2, skipping step 2 takes 1 clock out of the
# sequence, so the next step in the search — step 3 — is GIVEN it (4 -> 5) and
# the cycle is still 7. Un-skipping step 2 later takes the clock straight back
# out of step 3 (5 -> 4).
tickrate 100
patch <<<
[m4]
[motoquencer]
    clock          = I1
    fadermode      = I2
    buttonmode     = 3
    constantlength = I3
    numsteps       = 4
    numfaders      = 4
    quantize       = 0
    cvbase         = 0
    cvrange        = 1
    defaultgate    = 1
    cv             = O1
>>>
@2 move F1 0.0
@3 move F2 0.25
@4 move F3 0.5
@5 move F4 0.75
@6 set I2 3
# with the feature off, give step 3 four repeats (notch 3)
@7 move F3 0.2
@7 expect F3 0.2 tol 1e-4
@8 set I3 2
# plate 2 skips step 2 (-1 clock); step 3 is handed it: 4 -> 5 repeats (notch 4).
@9 touch F2 1
@9 expect F3 0.2666667 tol 1e-4
@9 expect F1 0 tol 1e-4
@9 expect F4 0 tol 1e-4
@10 touch F2 0
@11 set I2 0
# still 7 clocks: step 1, (step 2 skipped), step 3 five times, step 4.
@13 set I1 1
@13 expect O1 0 tol 1e-4
@14 set I1 0
@15 set I1 1
@15 expect O1 0.5 tol 1e-4
@16 set I1 0
@17 set I1 1
@17 expect O1 0.5 tol 1e-4
@18 set I1 0
@19 set I1 1
@19 expect O1 0.5 tol 1e-4
@20 set I1 0
@21 set I1 1
@21 expect O1 0.5 tol 1e-4
@22 set I1 0
@23 set I1 1
@23 expect O1 0.5 tol 1e-4
@24 set I1 0
@25 set I1 1
@25 expect O1 0.75 tol 1e-4
@26 set I1 0
@27 set I1 1
@27 expect O1 0 tol 1e-4
@28 set I1 0
# back to the repeats lane, and un-skip step 2: step 3 gives the clock back.
@30 set I2 3
@30 expect F3 0.2666667 tol 1e-4
@32 touch F2 1
@32 expect F3 0.2 tol 1e-4
@33 touch F2 0

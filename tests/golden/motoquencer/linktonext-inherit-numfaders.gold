# motoquencer linktonext: a chain member that omits `numfaders` / `numsteps`
# inherits BOTH from the chain main, not from the size of the M4 bank (#34).
#
# The Forge's own MFPS generator writes linked lanes exactly this way -- the
# velocity / gate-length lanes carry `page = _PAGE` and `linktonext = 1` but no
# `numfaders` or `numsteps`, while the main declares `numfaders = 8` and
# `numsteps = 16`. On hardware the PAGE button pages every lane; the member can
# only do that if it shares the main's geometry. Falling back to the bank size
# instead gives the member ONE page (8 faders, 8 steps on a two-M4 rack) and its
# `page` input clamps to 0, so pages 2+ of the member can never be edited.
#
# Here: two M4s (8 faders). The main uses 4 faders x 8 steps (2 pages); the
# member states nothing. Editing the member's CV on page 1 must land on step 5
# (index 4), which is only reachable if the member also has 2 pages of 4.
tickrate 100
patch <<<
[m4]
[m4]
[motoquencer]
    clock      = I1
    page       = I2
    fadermode  = I3
    numfaders  = 4
    numsteps   = 8
    linktonext = 1
    quantize   = 0
    cvbase     = 0
    cvrange    = 1
    cv         = O1
[motoquencer]
    page       = I2
    quantize   = 0
    cvbase     = 0
    cvrange    = 1
    holdcv     = 0
    cv         = O2
>>>
# member's CV lane (fadermode 10), page 1: F1 is the member's step index 4
@1 set I3 10
@2 set I2 1
@3 move F1 0.75
@3 expect F1 0.75 tol 1e-4
# a bank-sized member (8 faders) would NOT be paging: F5 stays a parked fader,
# never the member's step 5. Back on page 0, F1 recalls the untouched step 0.
@4 set I2 0
@4 expect F1 0.0 tol 1e-4
# run the clock: steps 0..3 play 0, step index 4 plays the page-1 edit
@5 set I1 1
@5 expect O2 0.0 tol 1e-4
@6 set I1 0
@7 set I1 1
@7 expect O2 0.0 tol 1e-4
@8 set I1 0
@9 set I1 1
@9 expect O2 0.0 tol 1e-4
@10 set I1 0
@11 set I1 1
@11 expect O2 0.0 tol 1e-4
@12 set I1 0
@13 set I1 1
@13 expect O2 0.75 tol 1e-4
@14 set I1 0
@15 set I1 1
@15 expect O2 0.0 tol 1e-4

# motoquencer `pattern` = 1 -- "two steps forward, one step backward" -->|>|<
# (issue #54). The manual spells this one out in prose, which is what this golden
# pins:
#
#   "Pattern 1 for example goes always two steps forwards (according to
#    `direction` and `pingpong`) and then one step backwards. Assuming
#    `direction = 0` and `pingpong = 0`, the step order would be
#    1, 2, 3, 2, 3, 4, 3, 4, 5, 4, 5, 6 and so on."
#
# Those step numbers are 1-based, so 0-based the order is
# 0,1,2, 1,2,3, 2,3,4, 3,4,5, ... -- exactly the trace below.
#
# SPEC-GAP: the manual never says when such a walk has completed a "cycle". We
# count one when the walk's forward progress crosses the END of the sequence: the
# +1 out of step 7 of eight would land past the last step, so instead the walk
# restarts at step 0 and `startofsequence` fires there (and only there).
# Step numbers do not fit on an output jack (they clamp at +/-10 V), so
# `currentstep` rides an internal cable scaled by 1/10: step N reads N/10.
tickrate 100
patch <<<
[m4]
[m4]
[motoquencer]
    clock           = I1
    numsteps        = 8
    numfaders       = 8
    pattern         = 1
    currentstep     = _CS
    startofsequence = O2
[copy]
    input  = _CS * 0.1
    output = O1
>>>
@2 set I1 1
@2 expect O1 0 tol 1e-4
@2 expect O2 1 tol 1e-4
@3 set I1 0
@4 set I1 1
@4 expect O1 0.1 tol 1e-4
@4 expect O2 0 tol 1e-4
@5 set I1 0
@6 set I1 1
@6 expect O1 0.2 tol 1e-4
@6 expect O2 0 tol 1e-4
@7 set I1 0
@8 set I1 1
@8 expect O1 0.1 tol 1e-4
@8 expect O2 0 tol 1e-4
@9 set I1 0
@10 set I1 1
@10 expect O1 0.2 tol 1e-4
@10 expect O2 0 tol 1e-4
@11 set I1 0
@12 set I1 1
@12 expect O1 0.3 tol 1e-4
@12 expect O2 0 tol 1e-4

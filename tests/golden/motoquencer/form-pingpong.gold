# motoquencer `form` = 5 (AB) combined with `pingpong` = 1 (issue #53).
#
# "The forms can be combined with `direction`, `pingpong` and `pattern`. Here
# stepping modifications are always applied within each individual part." So each
# half of the six steps ping-pongs on its OWN turning points: A = 0,1,2 plays
# 0,1,2,1 and B = 3,4,5 plays 3,4,5,4. The pingpong never reflects across the
# part seam -- after the A part's tail it moves forward into B.
# Step numbers do not fit on an output jack (they clamp at +/-10 V), so
# `currentstep` rides an internal cable scaled by 1/10: step N reads N/10.
tickrate 100
patch <<<
[m4]
[m4]
[motoquencer]
    clock           = I1
    numsteps        = 6
    numfaders       = 6
    form            = 5
    pingpong        = 1
    currentstep     = _CS
    startofpart     = O3
    startofsequence = O2
[copy]
    input  = _CS * 0.1
    output = O1
>>>
@2 set I1 1
@2 expect O1 0 tol 1e-4
@2 expect O3 1 tol 1e-4
@2 expect O2 1 tol 1e-4
@3 set I1 0
@4 set I1 1
@4 expect O1 0.1 tol 1e-4
@4 expect O3 0 tol 1e-4
@4 expect O2 0 tol 1e-4
@5 set I1 0
@6 set I1 1
@6 expect O1 0.2 tol 1e-4
@6 expect O3 0 tol 1e-4
@6 expect O2 0 tol 1e-4
@7 set I1 0
@8 set I1 1
@8 expect O1 0.1 tol 1e-4
@8 expect O3 0 tol 1e-4
@8 expect O2 0 tol 1e-4
@9 set I1 0
@10 set I1 1
@10 expect O1 0.3 tol 1e-4
@10 expect O3 1 tol 1e-4
@10 expect O2 0 tol 1e-4
@11 set I1 0
@12 set I1 1
@12 expect O1 0.4 tol 1e-4
@12 expect O3 0 tol 1e-4
@12 expect O2 0 tol 1e-4
@13 set I1 0
@14 set I1 1
@14 expect O1 0.5 tol 1e-4
@14 expect O3 0 tol 1e-4
@14 expect O2 0 tol 1e-4
@15 set I1 0
@16 set I1 1
@16 expect O1 0.4 tol 1e-4
@16 expect O3 0 tol 1e-4
@16 expect O2 0 tol 1e-4
@17 set I1 0
@18 set I1 1
@18 expect O1 0 tol 1e-4
@18 expect O3 1 tol 1e-4
@18 expect O2 1 tol 1e-4
@19 set I1 0

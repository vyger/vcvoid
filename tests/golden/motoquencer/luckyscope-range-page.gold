# motoquencer: `luckyscope` 2 = "all steps between the start and the end step,
# but just on the currently displayed page". Characterisation of the range as
# read by luckyTargets(), intersected with the page.
#
# 8 steps over 4 faders = two pages. With the range set to steps 2..7 and the
# display on page 1 (steps 5..8), the intersection is steps 5, 6 and 7:
# `luckygates` at luckyamount = 0 clears exactly those three. Steps 1..4 (in the
# range but on the other page) and step 8 (on the page but outside the range)
# keep their default gate. The range and the page are then widened/reset so the
# whole sequence can be heard: on, on, on, on, off, off, off, on.
tickrate 100
patch <<<
[m4]
[motoquencer]
    numfaders   = 4
    numsteps    = 8
    quantize    = 0
    defaultgate = 1
    clock       = I1
    page        = I6
    startstep   = I4
    endstep     = I5
    luckyscope  = 2
    gate        = O2
    luckygates  = I2
    luckyamount = I3
>>>
# range 2..7, page 1 -> the lucky targets are steps 5, 6, 7
@0 set I4 2
@0 set I5 7
@0 set I6 1
@1 set I3 0
@2 set I2 1
@3 set I2 0
# full range, back to page 0, then run the whole sequence
@4 set I4 1
@4 set I5 8
@4 set I6 0
@5 set I1 1
@5 expect O2 1 tol 1e-4
@6 set I1 0
@7 set I1 1
@7 expect O2 1 tol 1e-4
@8 set I1 0
@9 set I1 1
@9 expect O2 1 tol 1e-4
@10 set I1 0
@11 set I1 1
@11 expect O2 1 tol 1e-4
@12 set I1 0
# steps 5, 6, 7: cleared
@13 set I1 1
@13 expect O2 0 tol 1e-4
@14 set I1 0
@15 set I1 1
@15 expect O2 0 tol 1e-4
@16 set I1 0
@17 set I1 1
@17 expect O2 0 tol 1e-4
@18 set I1 0
# step 8: on the page, but outside the range -> untouched
@19 set I1 1
@19 expect O2 1 tol 1e-4
@20 set I1 0

# motoquencer `pattern` combined with `pingpong` = 1 (issue #54), the other half
# of "according to `direction` and `pingpong`".
#
# Ping pong over four steps is the six-entry order 0,1,2,3,2,1 ("since the steps
# at the turning points are played just once, a sequence of 8 steps in ping pong
# mode has a duration of 14, not 16"). Pattern 1 walks THAT list, so its figure
# turns around with the sequence: positions 0,1,2,1,2,3,2,3,4,3,4,5 spell the
# steps 0,1,2,1,2,3,2,3,2,3,2,1. Reading it as step numbers instead would have
# given 0,1,2,1,2,3,2,3,4 and run off the end of a four-step sequence.
# Step numbers do not fit on an output jack (they clamp at +/-10 V), so
# `currentstep` rides an internal cable scaled by 1/10: step N reads N/10.
tickrate 100
patch <<<
[m4]
[motoquencer]
    clock           = I1
    numsteps        = 4
    numfaders       = 4
    pattern         = 1
    pingpong        = 1
    currentstep     = _CS
    startofsequence = O2
[copy]
    input  = _CS * 0.1
    output = O1
>>>
@2 set I1 1
@2 expect O1 0 tol 1e-4
@2 expect O2 1 tol 1e-4
@3 set I1 0
@4 set I1 1
@4 expect O1 0.1 tol 1e-4
@4 expect O2 0 tol 1e-4
@5 set I1 0
@6 set I1 1
@6 expect O1 0.2 tol 1e-4
@6 expect O2 0 tol 1e-4

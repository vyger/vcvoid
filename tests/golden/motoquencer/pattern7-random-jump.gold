# motoquencer `pattern` = 7 -- "random jump to any allowed (other) note" (issue
# #54). One draw per clock off the engine's seeded xorshift, uniform over the
# other positions of the play order: the manual's parenthesis "(other)" is read
# strictly, so the walk never draws the step it is already on. Values below are
# the exact seed-1 draws.
#
# SPEC-GAP: as with pattern 5 a jump never "crosses the end", so a cycle is every
# N moves, N = the number of steps in the play order (8 here), and that Nth move
# is the restart at step 0 with `startofsequence`. Note the 8th and 9th clocks
# both play step 0: the last free jump happened to land there and the restart
# follows it -- the "other step" rule constrains one move, not two.
# Step numbers do not fit on an output jack (they clamp at +/-10 V), so
# `currentstep` rides an internal cable scaled by 1/10: step N reads N/10.
seed 1
tickrate 100
patch <<<
[m4]
[m4]
[motoquencer]
    clock           = I1
    numsteps        = 8
    numfaders       = 8
    pattern         = 7
    currentstep     = _CS
    startofsequence = O2
[copy]
    input  = _CS * 0.1
    output = O1
>>>
@2 set I1 1
@2 expect O1 0 tol 1e-4
@2 expect O2 1 tol 1e-4
@3 set I1 0
@4 set I1 1
@4 expect O1 0.2 tol 1e-4
@4 expect O2 0 tol 1e-4
@5 set I1 0
@6 set I1 1
@6 expect O1 0.4 tol 1e-4
@6 expect O2 0 tol 1e-4

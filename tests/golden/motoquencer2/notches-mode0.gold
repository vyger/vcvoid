# motoquencer2 `probabilitymode = 0` (the default): the gate-probability lane
# (fadermode 2) offers all EIGHT notches, exactly as motoquencer does. The notch
# grid is the observable: with 8 dents a raw fader position snaps to the nearest
# k/7, k = 0..7, and the stored value IS k (7 = always at the top, 0 = conditional
# at the bottom).
#   0.30 -> round(0.30*7) = 2 -> 2/7 = 0.285714
#   0.60 -> round(0.60*7) = 4 -> 4/7 = 0.571429
#   0.70 -> round(0.70*7) = 5 -> 5/7 = 0.714286
# Contrast with the same positions under probabilitymode 1 (five notches:
# 0.25 / 0.5 / 0.75) and 2 (four notches: 1/3 / 2/3 / 1.0) — see the sibling
# goldens. This one is the "narrowing is opt-in" pin.
experimental
tickrate 100
patch <<<
[m4]
[motoquencer2]
    numfaders = 4
    fadermode = 2
    clock     = I1
    cv        = O1
>>>
# tick1: the four lanes are dialled; each motor is re-commanded to the dent the
# stored value now sits at.
@1 move F1 0.0
@1 move F2 0.3
@1 move F3 0.6
@1 move F4 0.7
@1 expect F1 0.0 tol 1e-4
@1 expect F2 0.285714 tol 1e-4
@1 expect F3 0.571429 tol 1e-4
@1 expect F4 0.714286 tol 1e-4
# tick2: reading the commanded positions back changes nothing (each fader is
# still in its own dent).
@2 expect F1 0.0 tol 1e-4
@2 expect F2 0.285714 tol 1e-4
@2 expect F3 0.571429 tol 1e-4
@2 expect F4 0.714286 tol 1e-4

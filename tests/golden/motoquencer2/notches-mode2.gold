# motoquencer2 `probabilitymode = 2` (trig conditions only): the gate-probability
# lane offers FOUR notches — bottom to top: every 4th turn, every odd turn, every
# even turn, always, i.e. the stored indices 2, 4, 5, 7.
#
# 1. Four dents, so a raw position snaps to the nearest k/3:
#      0.40 -> round(0.40*3) = 1 -> 1/3 = 0.333333
#      0.60 -> round(0.60*3) = 2 -> 2/3 = 0.666667
#      1.00 ->                 3 -> 1.0
# 2. Widening to probabilitymode 0 reads the stored index off the eight-notch
#    grid as k/7:
#      dent 0 -> 2 (every 4th turn) -> 2/7 = 0.285714
#      dent 1 -> 4 (every odd turn) -> 4/7 = 0.571429
#      dent 2 -> 5 (every even turn)-> 5/7 = 0.714286
#      dent 3 -> 7 (always)         -> 1.0
experimental
tickrate 100
patch <<<
[m4]
[motoquencer2]
    numfaders       = 4
    fadermode       = 2
    probabilitymode = I3
    clock           = I1
    cv              = O1
>>>
@0 set I3 2
@1 move F1 0.0
@1 move F2 0.4
@1 move F3 0.6
@1 move F4 1.0
@1 expect F1 0.0 tol 1e-4
@1 expect F2 0.333333 tol 1e-4
@1 expect F3 0.666667 tol 1e-4
@1 expect F4 1.0 tol 1e-4
@2 expect F2 0.333333 tol 1e-4
@2 expect F3 0.666667 tol 1e-4
# tick3: all eight notches again -> 2 / 4 / 5 / 7.
@3 set I3 0
@3 expect F1 0.285714 tol 1e-4
@3 expect F2 0.571429 tol 1e-4
@3 expect F3 0.714286 tol 1e-4
@3 expect F4 1.0 tol 1e-4
@4 expect F1 0.285714 tol 1e-4
@4 expect F2 0.571429 tol 1e-4
@4 expect F3 0.714286 tol 1e-4

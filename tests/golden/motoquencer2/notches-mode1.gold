# motoquencer2 `probabilitymode = 1` (random chances only): the gate-probability
# lane offers FIVE notches — bottom to top: conditional, 12%, 25%, 50%, always,
# i.e. the stored indices 0, 1, 3, 6, 7. Two things are pinned here.
#
# 1. The notch grid is five dents, so a raw position snaps to the nearest k/4:
#      0.30 -> round(0.30*4) = 1 -> 0.25       (eight notches would give 0.285714)
#      0.60 -> round(0.60*4) = 2 -> 0.50       (           "           0.571429)
#      0.70 -> round(0.70*4) = 3 -> 0.75       (           "           0.714286)
# 2. The STORED value behind each dent is the subset's, not the dent number:
#    switching probabilitymode back to 0 re-commands every motor to the same
#    value's position on the eight-notch grid, which reads the stored index off
#    unambiguously as k/7:
#      dent 0 -> 0 (conditional) -> 0.0
#      dent 1 -> 1 (12%)         -> 1/7 = 0.142857
#      dent 2 -> 3 (25%)         -> 3/7 = 0.428571
#      dent 3 -> 6 (50%)         -> 6/7 = 0.857143
experimental
tickrate 100
patch <<<
[m4]
[motoquencer2]
    numfaders       = 4
    fadermode       = 2
    probabilitymode = I3
    clock           = I1
    cv              = O1
>>>
@0 set I3 1
# tick1: dial the four steps; the motors settle on the five-notch grid.
@1 move F1 0.0
@1 move F2 0.3
@1 move F3 0.6
@1 move F4 0.7
@1 expect F1 0.0 tol 1e-4
@1 expect F2 0.25 tol 1e-4
@1 expect F3 0.5 tol 1e-4
@1 expect F4 0.75 tol 1e-4
# tick2: stable under readback.
@2 expect F2 0.25 tol 1e-4
@2 expect F4 0.75 tol 1e-4
# tick3: widen back to all eight notches -> the motors move to the stored values'
# own positions, revealing 0 / 1 / 3 / 6.
@3 set I3 0
@3 expect F1 0.0 tol 1e-4
@3 expect F2 0.142857 tol 1e-4
@3 expect F3 0.428571 tol 1e-4
@3 expect F4 0.857143 tol 1e-4
@4 expect F2 0.142857 tol 1e-4
@4 expect F3 0.428571 tol 1e-4
@4 expect F4 0.857143 tol 1e-4

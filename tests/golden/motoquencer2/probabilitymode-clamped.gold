# motoquencer2: `probabilitymode` is an integer, rounded and clamped to 0..2 (like
# crossfader2's `curve`). A patch that drives it from a knob or a buttongroup must
# not be able to produce a fourth, undefined notch set. Pinned at both ends and on
# the rounding: the fader lands at 0.4, which reads back as
#   mode 0 (eight notches):  round(0.4*7) = 3 -> 3/7 = 0.428571
#   mode 1 (five notches):   round(0.4*4) = 2 -> 0.5
#   mode 2 (four notches):   round(0.4*3) = 1 -> 1/3 = 0.333333
# so the grid in force is visible in one number. Each step below re-dials F1 from
# the same raw 0.4, so the reading is independent of what the previous mode stored.
experimental
tickrate 100
patch <<<
[m4]
[motoquencer2]
    numfaders       = 4
    fadermode       = 2
    probabilitymode = I3
    clock           = I1
    cv              = O1
>>>
# -1 and 0.4 both clamp/round to 0: all eight notches.
@0 set I3 -1
@1 move F1 0.4
@1 expect F1 0.428571 tol 1e-4
@2 set I3 0.4
@3 move F1 0.4
@3 expect F1 0.428571 tol 1e-4
# 1.4 rounds to 1: five notches.
@4 set I3 1.4
@5 move F1 0.4
@5 expect F1 0.5 tol 1e-4
# 7 clamps to 2: four notches.
@6 set I3 7
@7 move F1 0.4
@7 expect F1 0.333333 tol 1e-4

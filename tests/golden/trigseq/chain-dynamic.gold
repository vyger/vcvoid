# `chaintonext` is DYNAMIC (sequencer's rule: "you could make or break the
# chain with a toggle button"). Breaking it mid-run shortens the sequence and
# the running position wraps modulo the NEW total length — it is not clamped
# and it is not reset.
#
# Head "x..." (emits at index 0) + follower "xx" (indices 4 and 5) = 6 steps
# while I3 is high. The step counter is monotone, so with the chain broken
# (length 4) the counter keeps advancing and folds: counter 6 -> index 2.
experimental
patch <<<
[trigseq]
    clock       = I1
    pattern     = "x..."
    chaintonext = I3
    output      = O1

[trigseq]
    pattern     = "xx"
>>>
@0 set I3 1
# chained, 6-step sequence: emit, rest, rest, rest, emit, emit
@1 set I1 1
@1 expect O1 1
@2 set I1 0
@3 set I1 1
@3 expect O1 0
@4 set I1 0
@5 set I1 1
@5 expect O1 0
@6 set I1 0
@7 set I1 1
@7 expect O1 0
@8 set I1 0
@9 set I1 1
@9 expect O1 1
@10 set I1 0
@11 set I1 1
@11 expect O1 1
@12 set I1 0
# break the chain: length drops to 4, the counter (now 6) folds to index 2
@13 set I3 0
@14 set I1 1
@14 expect O1 0
@15 set I1 0
# counter 7 -> index 3 -> rest
@16 set I1 1
@16 expect O1 0
@17 set I1 0
# counter 8 -> index 0 -> emit
@18 set I1 1
@18 expect O1 1
@19 set I1 0
# counter 9 -> index 1 -> rest
@20 set I1 1
@20 expect O1 0
@21 set I1 0
